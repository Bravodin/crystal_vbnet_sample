<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- useLegacyV2RuntimeActivationPolicy="true":
       sem isso, o Crystal costuma falhar ao carregar dados ADO.NET (push / SetDataSource)
       com FileNotFoundException em crdb_adoplus.dll. Clássico de entrevista. -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <add key="SqlServer" value=".\SQLEXPRESS" />
    <add key="Database" value="StudyERP" />
    <add key="IntegratedSecurity" value="true" />
    <add key="SqlUser" value="sa" />
    <add key="SqlPassword" value="bravo1234" />
    <!-- Relativo ao .exe. Se não existir, o app procura uma pasta "Reports" subindo os diretórios. -->
    <add key="ReportsFolder" value="Reports" />
    <add key="OutputFolder" value="Output" />
  </appSettings>

  <!-- Exemplo de binding redirect (deixe comentado; use no exercício de upgrade).
       Cenário: um componente/DLL de terceiros foi compilado contra um SP antigo
       (13.0.2000.0 / 13.0.3500.0) e a máquina só tem o runtime novo (13.0.4000.0).

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="CrystalDecisions.CrystalReports.Engine" publicKeyToken="692fbea5521e1304" culture="neutral" />
        <bindingRedirect oldVersion="13.0.0.0-13.0.3999.0" newVersion="13.0.4000.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="CrystalDecisions.Shared" publicKeyToken="692fbea5521e1304" culture="neutral" />
        <bindingRedirect oldVersion="13.0.0.0-13.0.3999.0" newVersion="13.0.4000.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="CrystalDecisions.ReportSource" publicKeyToken="692fbea5521e1304" culture="neutral" />
        <bindingRedirect oldVersion="13.0.0.0-13.0.3999.0" newVersion="13.0.4000.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="CrystalDecisions.Windows.Forms" publicKeyToken="692fbea5521e1304" culture="neutral" />
        <bindingRedirect oldVersion="13.0.0.0-13.0.3999.0" newVersion="13.0.4000.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  -->

</configuration>
